+        ScoredItem.VITAL_CAPACITY: 0,
+        ScoredItem.SPRINT_50M: 1,
+        ScoredItem.SIT_AND_REACH: 1,
+        ScoredItem.STANDING_JUMP: 0,
+        ScoredItem.PULL_UP_OR_SIT_UP: 0,
+        ScoredItem.DISTANCE_RUN: 1,
